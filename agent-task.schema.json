{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "attempt", "objective", "context", "scope_paths", "acceptance_criteria", "check_ids", "constraints", "previous_report_id"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
    "objective": {"type": "string", "minLength": 1},
    "context": {"type": "string"},
    "scope_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "check_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "previous_report_id": {"type": ["string", "null"]}
  }
}
